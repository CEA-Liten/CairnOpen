import os
import sys
from sys import platform

cairnBin =  os.path.join(os.path.dirname(os.path.realpath(__file__)), '@CAIRN_INSTALL_BINDIR@')
if platform == "win32":
    os.add_dll_directory(cairnBin)
else:
    old = os.environ.get("PATH")
    if old:
        os.environ["PATH"] = cairnBin + ":" + old
    else:
        os.environ["PATH"] = cairnBin
    cairnLib =  os.path.join(os.path.dirname(os.path.realpath(__file__)), '@CMAKE_INSTALL_LIBDIR@')
    old = os.environ.get("LD_LIBRARY_PATH")
    if old:
        os.environ["LD_LIBRARY_PATH"] = cairnLib + ":" + old
    else:
        os.environ["LD_LIBRARY_PATH"] = cairnLib

sys.path.append( cairnBin )
os.environ["CAIRN_BIN"] = cairnBin

from .@CAIRN_INSTALL_BINDIR@.cairn import *
from .pyInterface import *
#from cairn.fmiInterface.fmi_interface import FMI2Interface

