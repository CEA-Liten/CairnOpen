{
    "version": 3,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/out/${presetName}",
            "installDir": "${sourceDir}/bin/${presetName}",
            "cacheVariables": {
                "PRESETNAME": "${presetName}",
                "DEPS_ROOT": "${sourceDir}/deps"
            }
        },
        {
            "name": "windows-base",
            "inherits": "base",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "environment": {
                "GUI_HOME": "${sourceDir}/gui",
                "CAIRN_BIN": "${sourceDir}/bin/${presetName}/bin",
                "PATH": "${sourceDir}/bin/${presetName}/bin;C:/Qt/Qt5.15.0/5.15.0/msvc2019_64/bin;$penv{PATH}"
            }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "USER_OPTIONS_FILE": "cmake/linux_options.cmake"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "environment": {
                "CAIRN_BIN": "${sourceDir}/bin/${presetName}/lib",
                "LD_LIBRARY_PATH": "${sourceDir}/bin/${presetName}/lib:$penv{LD_LIBRARY_PATH}"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "hostOS": [ "Linux" ]
                },
                "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
                    "copySources": true,
                    "rsyncCommandArgs": [ "-t", "--delete" ],
                    "copySourcesOptions": {
                        "method": "rsync",
                        "exclusionList": [ ".*", "bin", "out", "doc", "gui", "scripts", "deps", "_skbuild", "virtualPy", "tests/apicpp/src/TEST_CairnCore.h" ]
                    },
                    "remoteSourceRootDir": "$env{HOME}/.vs/$ms{projectDirName}"
                }
            }
        },
        {
            "name": "linux-debug",
            "inherits": "linux-base",
            "displayName": "Linux Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "inherits": "windows-base",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "inherits": "debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "fulldebug",
            "displayName": "Full-Debug",
            "inherits": "debug",
            "cacheVariables": {
                "USER_OPTIONS_FILE": "cmake/full_options.cmake"
            }
        },
        {
            "name": "fullrelease",
            "displayName": "Full-Release",
            "inherits": "fulldebug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "wheel",
            "displayName": "Wheel",
            "inherits": "release",
            "installDir": "${sourceDir}/bin/release",
            "cacheVariables": {
                "BUILD_WHEEL": "ON",
                "INSTALL_WHEEL": "ON",
                "BUILD_MIPMODELER": "OFF",
                "BUILD_MODULECAIRN": "OFF",
                "BUILD_CAIRNGUI": "OFF",
                "BUILD_CAIRN": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "displayName": "Debug",
            "configurePreset": "debug",
            "configuration": "debug",
            "jobs": 4
        },
        {
            "name": "linux-debug",
            "displayName": "Linux Debug",
            "configurePreset": "linux-debug",
            "configuration": "debug",
            "jobs": 4
        },
        {
            "name": "release",
            "displayName": "Release",
            "configurePreset": "release",
            "configuration": "release",
            "jobs": 4
        },
        {
            "name": "fullrelease",
            "displayName": "Full-Release",
            "configurePreset": "fullrelease",
            "configuration": "release",
            "jobs": 4
        },
        {
            "name": "fulldebug",
            "displayName": "Full-Debug",
            "configurePreset": "fulldebug",
            "configuration": "debug",
            "jobs": 4
        }
    ],
    "testPresets": [
        {
            "name": "debug",
            "displayName": "Debug",
            "configurePreset": "debug",
            "configuration": "debug",
            "environment": {
                "GUI_HOME": "${sourceDir}/gui",
                "CAIRN_BIN": "${sourceDir}/bin/${presetName}/bin",
                "PATH": "${sourceDir}/bin/${presetName}/bin;C:/Qt/Qt5.15.0/5.15.0/msvc2019_64/bin;$penv{PATH}"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "configurePreset": "release",
            "configuration": "release",
            "environment": {
                "GUI_HOME": "${sourceDir}/gui",
                "CAIRN_BIN": "${sourceDir}/bin/${presetName}/bin",
                "PATH": "${sourceDir}/bin/${presetName}/bin;C:/Qt/Qt5.15.0/5.15.0/msvc2019_64/bin;$penv{PATH}"
            }
        },
        {
            "name": "fullrelease",
            "displayName": "Full-Release",
            "configurePreset": "fullrelease",
            "configuration": "release"
        },
        {
            "name": "fulldebug",
            "displayName": "Full-Debug",
            "configurePreset": "fulldebug",
            "configuration": "debug"
        },
        {
            "name": "linux-debug",
            "displayName": "Linux Debug",
            "configurePreset": "linux-debug",
            "configuration": "debug",
            "environment": {
                "CAIRN_BIN": "${sourceDir}/bin/${presetName}/lib",
                "LD_LIBRARY_PATH": "${sourceDir}/bin/${presetName}/lib:$penv{LD_LIBRARY_PATH}"
            }
        }
    ]
}